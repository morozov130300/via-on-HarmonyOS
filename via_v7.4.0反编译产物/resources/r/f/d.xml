<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fk"
        android:layout_width="0dp"
        android:layout_height="@dimen/g"
        android:layout_marginBottom="0dp"
        android:layout_toLeftOf="@+id/c6"
        android:layout_alignBottom="@+id/c6"
        android:layout_alignParentLeft="true"
        android:textDirection="locale"
        android:layout_toStartOf="@+id/c6"
        android:layout_alignParentStart="true"
        style="@style/a0"/>
    <ImageView
        android:id="@+id/c6"
        android:background="@drawable/q"
        android:padding="14dp"
        android:layout_width="@dimen/g"
        android:layout_height="@dimen/g"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:src="@drawable/bm"
        android:tint="?attr/a9"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/po"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fk"/>
    <TextView
        android:textSize="@dimen/a_"
        android:textColor="?attr/ad"
        android:gravity="center"
        android:id="@+id/ey"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fk"/>
</RelativeLayout>
