<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/fk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/yq"
        android:textDirection="locale"
        style="@style/a0"/>
    <ImageView
        android:id="@+id/c7"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="0dp"
        android:layout_below="@+id/fk"
        android:layout_alignTop="@+id/bp"
        android:contentDescription="@string/ft"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="0dp"/>
    <ImageView
        android:id="@+id/c2"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="-8dp"
        android:layout_marginRight="-8dp"
        android:src="@drawable/bd"
        android:tint="#55ffffff"
        android:layout_alignTop="@+id/c7"
        android:layout_alignRight="@+id/c7"
        android:contentDescription="@string/x"
        android:alpha="0.8"
        android:layout_marginEnd="-8dp"
        android:layout_alignEnd="@+id/c7"/>
    <HorizontalScrollView
        android:id="@+id/bp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:layout_toRightOf="@+id/c7"
        android:layout_below="@+id/fk"
        android:layout_toEndOf="@+id/c7"
        style="@style/j">
        <EditText
            android:id="@+id/b2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/kg"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionNext"
            android:textDirection="locale"
            style="@style/i"/>
    </HorizontalScrollView>
    <HorizontalScrollView
        android:id="@+id/bq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:layout_toRightOf="@+id/c7"
        android:layout_below="@+id/bp"
        android:layout_toEndOf="@+id/c7"
        style="@style/j">
        <EditText
            android:id="@+id/b3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/kh"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            style="@style/i"/>
    </HorizontalScrollView>
    <TextView
        android:id="@+id/ew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/ok"
        android:layout_below="@+id/bq"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        style="@style/y"/>
    <TextView
        android:id="@+id/er"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel"
        android:layout_toLeftOf="@+id/ew"
        android:layout_below="@+id/bq"
        android:layout_toStartOf="@+id/ew"
        style="@style/y"/>
</RelativeLayout>
