<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:text="@string/a1p"
        android:layout_toLeftOf="@+id/ek"
        android:layout_alignTop="@+id/ek"
        android:layout_alignBottom="@+id/ek"
        android:textDirection="locale"
        android:layout_toStartOf="@+id/ek"
        style="@style/a0"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ek"
        android:background="@drawable/o"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/g"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:text="@string/tl"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        style="@style/z"/>
    <EditText
        android:id="@+id/b3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/kh"
        android:layout_below="@+id/fk"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        style="@style/z"/>
    <EditText
        android:id="@+id/b4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ki"
        android:layout_below="@+id/b3"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionNext"
        style="@style/z"/>
    <EditText
        android:id="@+id/ax"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ke"
        android:layout_below="@+id/b4"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionNext"
        style="@style/z"/>
    <TextView
        android:id="@+id/ew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/ok"
        android:layout_below="@+id/ax"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        style="@style/y"/>
    <TextView
        android:id="@+id/er"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel"
        android:layout_toLeftOf="@+id/ew"
        android:layout_below="@+id/ax"
        android:layout_toStartOf="@+id/ew"
        style="@style/y"/>
    <TextView
        android:id="@+id/f8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mn"
        android:layout_below="@+id/ax"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        style="@style/y"/>
</RelativeLayout>
