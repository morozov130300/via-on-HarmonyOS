<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/a9"
        android:textColor="?attr/ad"
        android:gravity="center"
        android:id="@+id/ey"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/hg"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/di"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="48dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/g">
        <ImageView
            android:id="@+id/ck"
            android:background="@drawable/o"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/di"
            android:tint="?attr/a9"
            android:layout_weight="1"
            android:contentDescription="@string/tj"/>
        <SeekBar
            android:id="@+id/dk"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            style="@style/s"/>
        <ImageView
            android:id="@+id/cg"
            android:background="@drawable/o"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ac"
            android:tint="?attr/a9"
            android:layout_weight="1"
            android:contentDescription="@string/s6"/>
        <ImageView
            android:id="@+id/cd"
            android:background="@drawable/o"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/cw"
            android:tint="?attr/a9"
            android:layout_weight="1"
            android:contentDescription="@string/gq"/>
        <ImageView
            android:id="@+id/c3"
            android:background="@drawable/o"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/bp"
            android:tint="?attr/a9"
            android:layout_weight="1"
            android:contentDescription="@string/iy"/>
        <TextView
            android:textSize="@dimen/a_"
            android:typeface="sans"
            android:textColor="?attr/ac"
            android:gravity="center"
            android:id="@+id/ff"
            android:background="@drawable/o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
