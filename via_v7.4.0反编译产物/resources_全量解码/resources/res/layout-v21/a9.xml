<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/d1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="@dimen/as"
        android:layout_height="@dimen/ar"
        layout="@layout/a_"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/as">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/d3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ar">
            <FrameLayout
                android:id="@+id/d2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <FrameLayout
                android:id="@+id/de"
                android:paddingTop="@dimen/aw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp">
                <ViewStub
                    android:layout_gravity="end|top"
                    android:id="@+id/eg"
                    android:visibility="gone"
                    android:layout="@layout/ab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:layout_gravity="end|top"
                    android:id="@+id/at"
                    android:visibility="gone"
                    android:layout="@layout/aa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textAppearance="@style/v"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/bu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:singleLine="true"/>
            </FrameLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/a8"
            android:background="#29000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ad"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"/>
    </LinearLayout>
</FrameLayout>
