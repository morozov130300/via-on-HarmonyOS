<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/fk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/a10"
        style="@style/a0"/>
    <EditText
        android:id="@+id/b4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mp"
        android:selectAllOnFocus="true"
        android:layout_below="@+id/fk"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionNext"
        style="@style/z"/>
    <EditText
        android:id="@+id/ax"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ke"
        android:selectAllOnFocus="true"
        android:layout_below="@+id/b4"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        style="@style/z"/>
    <CheckBox
        android:id="@+id/an"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="12dp"
        android:button="?attr/a4"
        android:layout_below="@+id/ax"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        style="@style/a3"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/em"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/an"
        android:layout_below="@+id/ax"
        android:layout_alignTop="@+id/an"
        android:layout_alignBottom="@+id/an"
        android:layout_toEndOf="@+id/an"
        style="@style/a3"/>
    <TextView
        android:id="@+id/ew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/ok"
        android:layout_below="@+id/an"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        style="@style/y"/>
    <TextView
        android:id="@+id/er"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel"
        android:layout_toLeftOf="@+id/ew"
        android:layout_below="@+id/an"
        android:layout_toStartOf="@+id/ew"
        style="@style/y"/>
</RelativeLayout>
