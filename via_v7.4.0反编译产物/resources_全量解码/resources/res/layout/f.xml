<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/fk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/yp"
        android:textDirection="locale"
        style="@style/a0"/>
    <HorizontalScrollView
        android:id="@+id/bp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:layout_below="@+id/fk"
        style="@style/j">
        <EditText
            android:id="@+id/b2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/kg"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionNext"
            android:textDirection="locale"
            style="@style/i"/>
    </HorizontalScrollView>
    <HorizontalScrollView
        android:id="@+id/bq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:layout_below="@+id/bp"
        style="@style/j">
        <EditText
            android:id="@+id/b3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/kh"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            style="@style/i"/>
    </HorizontalScrollView>
    <TextView
        android:ellipsize="end"
        android:id="@+id/f4"
        android:background="@drawable/x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/kd"
        android:layout_below="@+id/bq"
        android:textDirection="locale"
        style="@style/z"/>
    <CheckBox
        android:id="@+id/am"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:button="?attr/a4"
        android:text="@string/e"
        android:layout_below="@+id/f4"
        android:textDirection="locale"
        style="@style/a3"/>
    <TextView
        android:id="@+id/ew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/ok"
        android:layout_below="@+id/am"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        style="@style/y"/>
    <TextView
        android:textColor="@color/g"
        android:id="@+id/et"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x"
        android:layout_below="@+id/am"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        style="@style/y"/>
    <TextView
        android:id="@+id/er"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel"
        android:layout_toLeftOf="@+id/ew"
        android:layout_below="@+id/am"
        android:layout_toStartOf="@+id/ew"
        style="@style/y"/>
</RelativeLayout>
