<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bz"
        android:background="@drawable/o"
        android:padding="@dimen/e"
        android:layout_width="@dimen/h"
        android:layout_height="@dimen/g"
        android:src="@drawable/b2"
        android:tint="?attr/a9"
        android:contentDescription="@string/o1"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fk"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="0dp"
        android:text="@string/tb"
        android:layout_toLeftOf="@+id/ci"
        android:layout_toRightOf="@+id/bz"
        android:layout_alignTop="@+id/bz"
        android:layout_alignBottom="@+id/bz"
        android:textDirection="locale"
        android:layout_toStartOf="@+id/ci"
        android:layout_toEndOf="@+id/bz"
        style="@style/a0"/>
    <EditText
        android:textSize="@dimen/a8"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/b0"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="0dp"
        android:hint="@string/sy"
        android:layout_toLeftOf="@+id/ca"
        android:layout_toRightOf="@+id/bz"
        android:layout_alignTop="@+id/bz"
        android:layout_alignBottom="@+id/bz"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        android:textDirection="locale"
        android:layout_toStartOf="@+id/ca"
        android:layout_toEndOf="@+id/bz"
        style="@style/a1"/>
    <ImageView
        android:id="@+id/ci"
        android:background="@drawable/q"
        android:padding="@dimen/e"
        android:layout_width="@dimen/g"
        android:layout_height="@dimen/g"
        android:src="@drawable/de"
        android:tint="?attr/a9"
        android:layout_toLeftOf="@+id/ca"
        android:layout_alignTop="@+id/fk"
        android:contentDescription="@string/sy"
        android:layout_toStartOf="@+id/ca"/>
    <ImageView
        android:id="@+id/ca"
        android:background="@drawable/q"
        android:padding="@dimen/e"
        android:layout_width="@dimen/g"
        android:layout_height="@dimen/g"
        android:src="@drawable/ay"
        android:tint="?attr/a9"
        android:layout_alignTop="@+id/fk"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/ac"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ej"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bg"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/bz">
        <ImageView
            android:id="@+id/cb"
            android:padding="@dimen/e"
            android:layout_width="@dimen/h"
            android:layout_height="@dimen/g"
            android:src="@drawable/c4"
            android:tint="?attr/a9"
            android:contentDescription="@string/ac"/>
        <EditText
            android:id="@+id/aw"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:hint="@string/ac"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:textDirection="locale"
            style="@style/a1"/>
        <TextView
            android:textSize="@dimen/a_"
            android:textColor="?attr/a7"
            android:gravity="center"
            android:id="@+id/f_"
            android:background="@drawable/o"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/h"
            android:text="@android:string/ok"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ej"
        android:layout_alignWithParentIfMissing="true"/>
    <TextView
        android:textSize="@dimen/a8"
        android:textColor="?attr/ad"
        android:id="@+id/ey"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hg"
        android:layout_centerInParent="true"/>
</RelativeLayout>
