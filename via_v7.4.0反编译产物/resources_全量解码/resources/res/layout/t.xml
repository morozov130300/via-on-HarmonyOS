<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="@dimen/a_"
        android:textColor="?attr/ac"
        android:gravity="top"
        android:id="@+id/az"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/y9"
        android:layout_toLeftOf="@+id/cf"
        android:inputType="textNoSuggestions"
        android:layout_toStartOf="@+id/cf"/>
    <ImageView
        android:id="@+id/cf"
        android:background="@drawable/q"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ct"
        android:tint="?attr/a9"
        android:layout_alignTop="@+id/az"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/fx"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="?attr/i"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/az"/>
    <ProgressBar
        android:id="@+id/d5"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="50"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:layout_below="@+id/az"/>
    <TextView
        android:textSize="@dimen/a_"
        android:textColor="?attr/ac"
        android:gravity="top"
        android:id="@+id/fl"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/c0"
        android:layout_below="@+id/az"
        android:textIsSelectable="true"
        android:layout_toStartOf="@+id/c0"/>
    <ImageView
        android:id="@+id/c0"
        android:background="@drawable/q"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ba"
        android:tint="?attr/a9"
        android:layout_alignTop="@+id/fl"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/v"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/fl">
        <TextView
            android:textSize="@dimen/aa"
            android:textColor="?attr/ac"
            android:gravity="center"
            android:id="@+id/fe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/cn"
            android:background="@drawable/q"
            android:padding="14dp"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@drawable/dv"
            android:tint="?attr/a9"
            android:contentDescription="@string/fz"/>
        <TextView
            android:textSize="@dimen/aa"
            android:textColor="?attr/ac"
            android:gravity="center"
            android:id="@+id/fj"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cp"
            android:padding="9dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:src="@drawable/e3"
            android:tint="@android:color/white"
            android:contentDescription="@string/aw"/>
    </LinearLayout>
</RelativeLayout>
