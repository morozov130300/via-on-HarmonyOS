{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "routerMap": "$profile:router_map",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.PRINT"
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:perm_camera_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:perm_microphone_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:perm_location_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.VIBRATE"
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:read_pasteboard_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.NFC_TAG"
      },
      {
        // 原版 ACCESS_WIFI_STATE → 鸿蒙 GET_WIFI_INFO（官方 permissions-for-all）
        "name": "ohos.permission.GET_WIFI_INFO"
      },
      {
        // 原版 USE_BIOMETRIC / USE_FINGERPRINT → 鸿蒙 ACCESS_BIOMETRIC（官方）
        "name": "ohos.permission.ACCESS_BIOMETRIC"
      },
      {
        // 原版 POST_NOTIFICATIONS → 鸿蒙 PUBLISH_AGENT_REMINDER（官方，代理提醒）
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER"
      },
      {
        // 原版 CREDENTIAL_MANAGER_SET_ORIGIN → 鸿蒙 ACCESS_CERT_MANAGER（官方）
        "name": "ohos.permission.ACCESS_CERT_MANAGER"
      },
      {
        // 原版 READ_SETTINGS / QUERY_ALL_PACKAGES 语义 → GET_BUNDLE_INFO（官方）
        "name": "ohos.permission.GET_BUNDLE_INFO"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton",
        "backgroundModes": [
          "audioPlayback"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              { "scheme": "http" },
              { "scheme": "https" },
              { "scheme": "uia" },
              { "scheme": "inline" },
              { "scheme": "file" },
              { "scheme": "content" },
              { "scheme": "via" },
              { "type": "video/*" },
              { "type": "*/*" },
              { "type": "text/html" },
              { "type": "text/plain" },
              { "type": "application/xhtml+xml" },
              { "type": "application/vnd.wap.xhtml+xml" },
              { "type": "multipart/related" }
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              { "type": "text/plain" }
            ]
          },
          {
            // 原版 WEB_SEARCH / SEND / PROCESS_TEXT 等价入口（官方 wantConstant：
            // ACTION_SEARCH=ohos.want.action.search、ACTION_SEND=sendData；PROCESS_TEXT 无对应 action，由 viewData 承接）
            "actions": [
              "ohos.want.action.search",
              "ohos.want.action.sendData",
              "ohos.want.action.viewData"
            ],
            "entities": [
              "entity.system.default",
              "entity.system.browsable"
            ],
            "uris": [
              { "type": "text/plain" }
            ]
          },
          {
            // 原版 AndroidManifest NDEF_DISCOVERED（http/https/uia）：NFC 碰一碰打开网址
            // actions 必须为 "ohos.nfc.tag.action.TAG_FOUND"，后台匹配 NDEF 技术类型标签
            "actions": [
              "ohos.nfc.tag.action.TAG_FOUND"
            ],
            "uris": [
              { "type": "tag-tech/Ndef" }
            ]
          }
        ],
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        // 原版 AndroidManifest SearchWidgetProvider/TransparentSearchWidgetProvider 两个 receiver
        // （meta-data android.appwidget.provider @xml/h、@xml/i）；鸿蒙 Form Kit 一个 form 扩展
        // 承载两张卡片（form_config.json forms: searchWidget/transparentSearchWidget）
        "name": "SearchFormAbility",
        "srcEntry": "./ets/entryformability/SearchFormAbility.ets",
        "label": "$string:search_widget_name",
        "description": "$string:search_widget_desc",
        "type": "form",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}