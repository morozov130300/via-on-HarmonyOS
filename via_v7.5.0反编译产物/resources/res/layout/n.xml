<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/by"
        android:background="@drawable/p"
        android:padding="@dimen/e"
        android:layout_width="@dimen/h"
        android:layout_height="@dimen/g"
        android:src="@drawable/b0"
        android:tint="?attr/a_"
        android:contentDescription="@string/ob"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:text="@string/ty"
        android:layout_toRightOf="@+id/by"
        android:layout_alignTop="@+id/by"
        android:layout_alignBottom="@+id/by"
        android:textDirection="locale"
        android:layout_toEndOf="@+id/by"
        style="@style/a0"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/co"
        android:background="@drawable/q"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/fk">
        <TextView
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/a2i"
            android:layout_weight="1"
            style="@style/a6"/>
        <CheckBox
            android:id="@+id/ap"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:button="?attr/a5"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/q"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/co">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/kn"
            style="@style/a6"/>
        <EditText
            android:id="@+id/ay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp"
            android:hint="/Via"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionNext"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="0dp"
            style="@style/z"/>
    </LinearLayout>
</RelativeLayout>
