<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/by"
        android:background="@drawable/p"
        android:padding="@dimen/e"
        android:layout_width="@dimen/h"
        android:layout_height="@dimen/g"
        android:src="@drawable/b0"
        android:tint="?attr/a_"
        android:contentDescription="@string/ob"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fk"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="0dp"
        android:text="@string/to"
        android:layout_toLeftOf="@+id/cg"
        android:layout_toRightOf="@+id/by"
        android:layout_alignTop="@+id/by"
        android:layout_alignBottom="@+id/by"
        android:textDirection="locale"
        android:layout_toStartOf="@+id/cg"
        android:layout_toEndOf="@+id/by"
        style="@style/a0"/>
    <EditText
        android:textSize="@dimen/a8"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/az"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="0dp"
        android:hint="@string/t_"
        android:layout_toLeftOf="@+id/c_"
        android:layout_toRightOf="@+id/by"
        android:layout_alignTop="@+id/by"
        android:layout_alignBottom="@+id/by"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        android:textDirection="locale"
        android:layout_toStartOf="@+id/c_"
        android:layout_toEndOf="@+id/by"
        style="@style/a1"/>
    <ImageView
        android:id="@+id/cg"
        android:background="@drawable/r"
        android:padding="@dimen/e"
        android:layout_width="@dimen/g"
        android:layout_height="@dimen/g"
        android:src="@drawable/dd"
        android:tint="?attr/a_"
        android:layout_toLeftOf="@+id/c_"
        android:layout_alignTop="@+id/fk"
        android:contentDescription="@string/t_"
        android:layout_toStartOf="@+id/c_"/>
    <ImageView
        android:id="@+id/c_"
        android:background="@drawable/r"
        android:padding="@dimen/e"
        android:layout_width="@dimen/g"
        android:layout_height="@dimen/g"
        android:src="@drawable/aw"
        android:tint="?attr/a_"
        android:layout_alignTop="@+id/fk"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/ad"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ej"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bg"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/by">
        <ImageView
            android:id="@+id/ca"
            android:padding="@dimen/e"
            android:layout_width="@dimen/h"
            android:layout_height="@dimen/g"
            android:src="@drawable/c2"
            android:tint="?attr/a_"
            android:contentDescription="@string/ad"/>
        <EditText
            android:id="@+id/aw"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:hint="@string/ad"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:textDirection="locale"
            style="@style/a1"/>
        <TextView
            android:textSize="@dimen/a_"
            android:textColor="?attr/a8"
            android:gravity="center"
            android:id="@+id/f_"
            android:background="@drawable/p"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/h"
            android:text="@android:string/ok"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ej"
        android:layout_alignWithParentIfMissing="true"/>
    <TextView
        android:textSize="@dimen/a8"
        android:textColor="?attr/ae"
        android:id="@+id/ey"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hr"
        android:layout_centerInParent="true"/>
</RelativeLayout>
