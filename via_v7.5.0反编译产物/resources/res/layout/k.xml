<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/a9"
        android:textColor="?attr/ae"
        android:gravity="center"
        android:id="@+id/ey"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/hr"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/de"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="48dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:id="@+id/cr"
        android:layout_width="match_parent"
        android:layout_height="@dimen/g">
        <ImageView
            android:id="@+id/ci"
            android:background="@drawable/p"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/dh"
            android:tint="?attr/a_"
            android:layout_weight="1"
            android:contentDescription="@string/tw"/>
        <SeekBar
            android:id="@+id/dg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            style="@style/s"/>
        <ImageView
            android:id="@+id/ce"
            android:background="@drawable/p"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/aa"
            android:tint="?attr/a_"
            android:layout_weight="1"
            android:contentDescription="@string/sh"/>
        <ImageView
            android:id="@+id/cc"
            android:background="@drawable/p"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/cv"
            android:tint="?attr/a_"
            android:layout_weight="1"
            android:contentDescription="@string/h1"/>
        <ImageView
            android:id="@+id/c1"
            android:background="@drawable/p"
            android:padding="@dimen/e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/bn"
            android:tint="?attr/a_"
            android:layout_weight="1"
            android:contentDescription="@string/j7"/>
        <TextView
            android:textSize="@dimen/a_"
            android:typeface="sans"
            android:textColor="?attr/ad"
            android:gravity="center"
            android:id="@+id/ff"
            android:background="@drawable/p"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
