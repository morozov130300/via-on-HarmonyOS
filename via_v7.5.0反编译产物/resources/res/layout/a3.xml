<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@+id/fn"
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
    <TextView
        android:textSize="@dimen/a_"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/fk"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="56dp"
        android:singleLine="true"
        android:layout_marginEnd="56dp"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_gravity="center"
        android:id="@+id/f5"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/fg"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/kw"/>
    <RelativeLayout
        android:id="@+id/db"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <FrameLayout
            android:textColor="?attr/a_"
            android:id="@+id/bj"
            android:layout_width="@dimen/b5"
            android:layout_height="@dimen/b5"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="@dimen/b3"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="@dimen/b3"
            android:layout_above="@+id/c9"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cj"
                android:padding="@dimen/b4"
                android:visibility="gone"
                android:layout_width="@dimen/b5"
                android:layout_height="@dimen/b5"
                android:src="@drawable/dm"
                android:tint="@android:color/white"
                android:contentDescription="@null"
                android:importantForAccessibility="no"/>
            <TextView
                android:textSize="11dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:id="@+id/ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/c9"
            android:padding="@dimen/b4"
            android:layout_width="@dimen/b5"
            android:layout_height="@dimen/b5"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="@dimen/b3"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="@dimen/b3"
            android:src="@drawable/e2"
            android:tint="@android:color/white"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/mw"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/cf"
            android:padding="@dimen/b4"
            android:layout_width="@dimen/b5"
            android:layout_height="@dimen/b5"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="@dimen/b3"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="@dimen/b3"
            android:src="@drawable/d8"
            android:tint="@android:color/white"
            android:layout_below="@+id/c9"
            android:layout_alignParentRight="true"
            android:contentDescription="@string/q8"
            android:layout_alignParentEnd="true"/>
        <Space
            android:id="@+id/d1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/c5"
            android:padding="@dimen/b4"
            android:visibility="gone"
            android:layout_width="@dimen/b5"
            android:layout_height="@dimen/b5"
            android:layout_marginBottom="@dimen/b3"
            android:tint="@android:color/white"
            android:layout_above="@+id/d1"
            android:contentDescription="@string/a27"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/cd"
            android:padding="@dimen/b4"
            android:layout_width="@dimen/b5"
            android:layout_height="@dimen/b5"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="@dimen/b3"
            android:layout_marginRight="16dp"
            android:src="@drawable/cu"
            android:tint="@android:color/white"
            android:layout_below="@+id/d1"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/r3"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</merge>
