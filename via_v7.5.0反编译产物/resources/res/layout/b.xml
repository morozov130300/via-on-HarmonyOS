<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/aa"
        android:textColor="?attr/ae"
        android:textColorHint="?attr/ae"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ex"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/n2"
        android:maxLines="1"
        android:lines="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:gravity="center"
            android:id="@+id/cl"
            android:background="@drawable/q"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/a_"
            android:tint="?attr/a_"
            android:layout_weight="1"
            android:contentDescription="@string/n3"/>
        <TextView
            android:textColor="?attr/ad"
            android:gravity="center"
            android:id="@+id/ez"
            android:background="@drawable/q"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/n1"
            android:layout_weight="1"/>
        <TextView
            android:textColor="?attr/ad"
            android:gravity="center"
            android:id="@+id/fd"
            android:background="@drawable/q"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/n4"
            android:layout_weight="1"/>
        <TextView
            android:enabled="false"
            android:textColor="?attr/ad"
            android:gravity="center"
            android:id="@+id/fa"
            android:background="@drawable/q"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/an"
            android:layout_weight="1"/>
        <TextView
            android:textColor="?attr/ad"
            android:gravity="center"
            android:id="@+id/fb"
            android:background="@drawable/q"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/aq"
            android:layout_weight="1"/>
        <TextView
            android:textColor="?attr/ad"
            android:gravity="center"
            android:id="@+id/er"
            android:background="@drawable/q"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@android:string/cancel"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
